{
  "name": "springfield-3000",
  "version": "1.0.22",
  "description": "Serverless Stremio Addon for The Simpsons & Futurama curated sagas, story arcs, and anthologies (Bilingual EN/ES)",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "verify:cinemeta": "tsc -p tsconfig.scripts.json && node scripts/validate-cinemeta.js",
    "posters:build": "tsc -p tsconfig.scripts.json && node scripts/generate-posters.js"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261024.1",
    "@types/node": "^22.20.5",
    "sharp": "^0.35.5",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "^8.12.3"
  }
}
